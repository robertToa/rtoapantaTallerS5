<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="rtoapantaTallerS5.Views.vPersona"
             Title="vPersona">
    <VerticalStackLayout Padding="15" Spacing="15">
        <Label 
            Text="Semana 5: SQLite"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center"/>

        <Entry x:Name="txtNombre"
                   Placeholder="Ingrese el nombre"/>
        <Grid Padding="5" RowSpacing="1" ColumnSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnAgregar"
                    Text="Agregar Persona"
                    Clicked="btn_Agregar_Clicked"
                    Grid.Row="0"
                    Grid.Column="0"/>
            <Label x:Name="lblMessage"
                   TextColor="Red"
                   Grid.Row="1"
                   Grid.Column="0"/>
            <Button x:Name="btnMostrar"
                    Text="Mostrar Personas"
                    Clicked="btnMostrar_Cliecked"
                    Grid.Row="2"
                    Grid.Column="1"/>
            <CollectionView x:Name="listaPersonas"
                            Grid.Row="3"
                            Grid.Column="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Text="{Binding Id}"
                                   Grid.Row="0"
                                   Grid.Column="0"/>
                            <Label Text="{Binding Name}"
                                   Grid.Row="0"
                                   Grid.Column="1"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Label 
            Text="Crud adicional"
            TextColor="Blue"
            FontSize="15"/>
        <Entry x:Name="txtId"
           Placeholder="Ingrese el identificador de la persona"/>
        <Button x:Name="btnActualizar"
                Text="Actualizar Persona"
                Clicked="btnActualizar_Clicked"/>
        <Button x:Name="btnEliminar"
                Text="Eliminar Persona"
                Clicked="btnDelete_Clicked"/>
    </VerticalStackLayout>
</ContentPage>