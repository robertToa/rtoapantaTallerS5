<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="rtoapantaTallerS5.Views.vPersona"
             Title="vPersona">
    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Text="Semana 5: SQLite"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <Border Grid.Row="1"
                Padding="16"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Label Text="Datos de la persona"
                       FontSize="18"
                       FontAttributes="Bold" />
                <Grid ColumnDefinitions="110,*" ColumnSpacing="10" RowSpacing="10" Grid.Row="2" Grid.Column="2">
                    <Label Text="Id"
                           VerticalOptions="Center"
                           FontAttributes="Bold" 
                           Grid.Row="0"
                           Grid.Column="0"/>
                    <Entry x:Name="txtId"
                           Grid.Row="0"
                           Grid.Column="1"
                           Placeholder="Identificador"
                           IsEnabled="False" />
                    <Label Grid.Row="1"
                           Grid.Column="0"
                           Text="Nombre"
                           VerticalOptions="Center"
                           FontAttributes="Bold" />
                    <Entry x:Name="txtNombre"
                           Grid.Row="1"
                           Grid.Column="1"
                           Placeholder="Ingrese el nombre" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Label x:Name="lblMessage"
               Grid.Row="2"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               HorizontalOptions="Center" />

        <CollectionView x:Name="listaPersonas"
                        Grid.Row="3"
                        SelectionMode="Single"
                        SelectionChanged="listaPersonas_SelectionChanged">
            <CollectionView.Header>
                <Grid Padding="12,8"
                      ColumnDefinitions="80,*"
                      BackgroundColor="{StaticResource Primary}">
                    <Label Text="ID"
                           TextColor="White"
                           FontAttributes="Bold" />
                    <Label Grid.Column="1"
                           Text="NOMBRE"
                           TextColor="White"
                           FontAttributes="Bold" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="No hay personas registradas"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{StaticResource Gray500}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4"
                            Padding="12"
                            Stroke="{StaticResource Gray200}"
                            BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="80,*">
                            <Label Text="{Binding Id}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   TextColor="{StaticResource Gray900}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="4"
              ColumnDefinitions="*,*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="8">
            <Button x:Name="btnAgregar"
                    Text="Agregar"
                    Clicked="btn_Agregar_Clicked" />
            <Button x:Name="btnMostrar"
                    Grid.Column="1"
                    Text="Mostrar"
                    Clicked="btnMostrar_Cliecked"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="{StaticResource PrimaryDarkText}" />
            <Button x:Name="btnActualizar"
                    Grid.Column="2"
                    Text="Actualizar"
                    Clicked="btnActualizar_Clicked" />
            <Button x:Name="btnEliminar"
                    Grid.ColumnSpan="3"
                    Margin="0,8,0,0"
                    Text="Eliminar selección"
                    Clicked="btnDelete_Clicked"
                    BackgroundColor="#C62828"
                    TextColor="White"
                    Grid.Row="1" />
        </Grid>
    </Grid>
</ContentPage>